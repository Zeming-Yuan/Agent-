{
	admin off
	auto_https disable_redirects
	skip_install_trust
	servers {
		protocols h1 h2
	}
}
https://192.168.10.77:18443 {
	bind 192.168.10.77
	tls internal
	header -Server
	request_body {
		max_size 65MB
	}
	reverse_proxy 127.0.0.1:18008 {
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 600s
			read_timeout 900s
		}
	}
}
